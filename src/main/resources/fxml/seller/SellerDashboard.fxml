<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.image.ImageView?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            prefWidth="1536"
            prefHeight="960"
            stylesheets="@../../css/seller.css"
            fx:controller="com.auction.client.controller.seller.PostAuctionController">

    <center>
        <ScrollPane fitToWidth="true" styleClass="center-scroll">
            <VBox spacing="20" styleClass="main-container">

                <padding>
                    <Insets top="30" right="50" bottom="50" left="50"/>
                </padding>

                <VBox spacing="5">
                    <Label text="ĐĂNG SẢN PHẨM ĐẤU GIÁ" styleClass="page-title"/>
                    <Label text="Điền đầy đủ thông tin để đưa sản phẩm của bạn lên sàn đấu giá." styleClass="page-subtitle"/>
                </VBox>

                <VBox spacing="15" styleClass="card">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="📄" style="-fx-text-fill: #7A1C1C; -fx-font-size: 16px;"/>
                        <Label text="Thông tin cơ bản" styleClass="card-title"/>
                    </HBox>

                    <HBox spacing="20">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Tên sản phẩm *" style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
                            <TextField fx:id="txtProductName" promptText="Nhập tên sản phẩm" styleClass="modern-input"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Danh mục *" style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
                            <ComboBox fx:id="cbCategory" promptText="-- Chọn danh mục --" styleClass="modern-combo" maxWidth="Infinity"/>
                        </VBox>
                    </HBox>

                    <VBox spacing="5">
                        <Label text="Mô tả sản phẩm *" style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
                        <VBox styleClass="editor-box">
                            <TextArea fx:id="txtDescription" prefRowCount="4" wrapText="true"
                                      promptText="Mô tả chi tiết về sản phẩm: tình trạng, đặc điểm, xuất xứ, v.v." styleClass="editor-area"/>
                            <HBox alignment="CENTER_RIGHT"><Label text="0/3000" style="-fx-text-fill: #A0968C; -fx-font-size: 11px; -fx-padding: 0 5 5 0;"/></HBox>
                        </VBox>
                        <Button fx:id="btnUploadImage" onAction="#handleUploadImage" prefHeight="40.0" style="-fx-background-color: #F8F9FA; -fx-border-color: #DDD; -fx-border-radius: 8; -fx-cursor: hand;" text="📸 Tải lên ảnh sản phẩm" maxWidth="Infinity" />
                    </VBox>
                </VBox>

                <VBox spacing="15" styleClass="card">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="💵" style="-fx-text-fill: #7A1C1C; -fx-font-size: 16px;"/>
                        <Label text="Thông tin nhanh" styleClass="card-title"/>
                    </HBox>
                    <HBox spacing="20">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Giá khởi điểm *" style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
                            <HBox alignment="CENTER_RIGHT" styleClass="modern-input">
                                <TextField fx:id="txtStartingPrice" promptText="Nhập giá" style="-fx-background-color: transparent; -fx-padding: 0;" HBox.hgrow="ALWAYS"/>
                                <Label text="đ" textFill="#888888"/>
                            </HBox>
                        </VBox>

                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Bước giá (Increment) *" style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
                            <HBox alignment="CENTER_RIGHT" styleClass="modern-input">
                                <TextField fx:id="txtIncrement" promptText="Nhập bước giá" style="-fx-background-color: transparent; -fx-padding: 0;" HBox.hgrow="ALWAYS"/>
                                <Label text="đ" textFill="#888888"/>
                            </HBox>
                        </VBox>

                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Giá mua ngay (Tùy chọn)" style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
                            <HBox alignment="CENTER_RIGHT" styleClass="modern-input">
                                <TextField fx:id="txtBuyNowPrice" promptText="Nhập giá mua ngay" style="-fx-background-color: transparent; -fx-padding: 0;" HBox.hgrow="ALWAYS"/>
                                <Label text="đ" textFill="#888888"/>
                            </HBox>
                        </VBox>
                    </HBox>
                </VBox>

                <VBox spacing="15" styleClass="card">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="🕒" style="-fx-text-fill: #7A1C1C; -fx-font-size: 16px;"/>
                        <Label text="Thời gian đấu giá" styleClass="card-title"/>
                    </HBox>
                    <HBox spacing="20">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Ngày bắt đầu *" style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
                            <HBox spacing="10">
                                <DatePicker fx:id="dpStartDate" promptText="22/05/2024" HBox.hgrow="ALWAYS" styleClass="modern-date" maxWidth="Infinity"/>
                                <TextField fx:id="txtStartTime" promptText="14:30" prefWidth="80" styleClass="modern-input" alignment="CENTER"/>
                            </HBox>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Thời gian kết thúc *" style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
                            <HBox spacing="10">
                                <DatePicker fx:id="dpEndDate" promptText="25/05/2024" HBox.hgrow="ALWAYS" styleClass="modern-date" maxWidth="Infinity"/>
                                <TextField fx:id="txtEndTime" promptText="14:30" prefWidth="80" styleClass="modern-input" alignment="CENTER"/>
                            </HBox>
                            <Label text="(Tối thiểu 15 phút, tối đa 30 ngày)" style="-fx-text-fill: #888888; -fx-font-size: 11px;"/>
                        </VBox>
                    </HBox>
                    <VBox spacing="2">
                        <CheckBox fx:id="chkAntiSniping" text="Áp dụng gia hạn thời gian (Anti-sniping) ⓘ" style="-fx-text-fill: #1A0F0A; -fx-font-size: 12px;"/>
                        <Label text="Nếu có người đấu giá trong 30 giây cuối, thời gian sẽ được gia hạn thêm 60 giây." style="-fx-text-fill: #888888; -fx-font-size: 11px; -fx-padding: 0 0 0 22;"/>
                    </VBox>
                </VBox>

                <CheckBox fx:id="chkCommit" text="Tôi cam kết thông tin sản phẩm chuẩn xác, minh bạch." style="-fx-text-fill: #1A0F0A; -fx-font-size: 12px;"/>

                <HBox alignment="CENTER">
                    <Button text="Xóa" styleClass="btn-cancel" prefWidth="100" onAction="#handleClearForm"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Đăng" styleClass="btn-next" prefWidth="120" onAction="#handleSubmitAuction"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

    <right>
        <VBox prefWidth="320" spacing="20" styleClass="preview-sidebar">
            <padding>
                <Insets top="25" right="20" bottom="25" left="20"/>
            </padding>

            <HBox spacing="15" alignment="CENTER_RIGHT">
                <StackPane>
                    <Label text="🔔" style="-fx-font-size: 16px;"/>
                    <Circle radius="3" fill="#7A1C1C" StackPane.alignment="TOP_RIGHT"/>
                </StackPane>
                <Label text="💬" style="-fx-font-size: 16px;"/>
                <HBox spacing="8" alignment="CENTER">
                    <Circle radius="16" fill="#D2B4A1"/>

                    <VBox alignment="CENTER_LEFT">
                        <Label fx:id="lblProfileName" text="Chào, Đang tải..." style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                        <Label fx:id="lblProfileRole" text="Seller" style="-fx-font-size: 11px; -fx-text-fill: #888888;"/>
                    </VBox>
                </HBox>
            </HBox>

            <VBox spacing="15">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="👁" style="-fx-text-fill: #7A1C1C; -fx-font-size: 14px;"/>
                    <Label text="XEM TRƯỚC SẢN PHẨM" styleClass="preview-title"/>
                </HBox>

                <VBox spacing="10">
                    <StackPane prefHeight="220" styleClass="preview-image">
                        <Label text="[Hình ảnh sản phẩm]" textFill="#A0968C"/>
                        <ImageView fx:id="imgPreview" fitWidth="200" fitHeight="200" preserveRatio="true"/>
                    </StackPane>
                </VBox>

                <VBox spacing="12">
                    <VBox spacing="2">
                        <Label text="Tên sản phẩm" styleClass="preview-label"/>
                        <Label fx:id="lblPreviewName" text="Tên sản phẩm mẫu..." styleClass="preview-product-name"/>
                    </VBox>
                    <VBox spacing="2">
                        <Label text="Danh mục" styleClass="preview-label"/>
                        <Label fx:id="lblPreviewCategory" text="Chưa chọn" style="-fx-font-size: 13px; -fx-text-fill: #1A0F0A;"/>
                    </VBox>
                    <VBox spacing="2">
                        <Label text="Giá khởi điểm" styleClass="preview-label"/>
                        <Label fx:id="lblPreviewPrice" text="0 đ" styleClass="preview-price"/>
                    </VBox>
                    <VBox spacing="2">
                        <Label text="Bước giá" styleClass="preview-label"/>
                        <Label fx:id="lblPreviewIncrement" text="0 đ" style="-fx-font-size: 13px; -fx-text-fill: #1A0F0A;"/>
                    </VBox>
                    <VBox spacing="2">
                        <Label text="Thời gian" styleClass="preview-label"/>
                        <Label fx:id="lblPreviewTime" text="--/--/---- --:--&#10;đến --/--/---- --:--" style="-fx-font-size: 13px; -fx-text-fill: #1A0F0A;"/>
                    </VBox>
                    <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 5 0 0 0;">
                        <Label text="Gia hạn thời gian" styleClass="preview-label"/>
                        <Label fx:id="lblPreviewAntiSniping" text="Không áp dụng" styleClass="tag-success"/>
                    </HBox>
                </VBox>

                <Region prefHeight="5"/>
                <Label text="Lưu ý: Thông tin chỉ mang tính chất minh họa.&#10;Vui lòng kiểm tra lại trước khi đăng."
                       wrapText="true" style="-fx-text-fill: #A0968C; -fx-font-size: 11px; -fx-alignment: CENTER;" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </right>

</BorderPane>