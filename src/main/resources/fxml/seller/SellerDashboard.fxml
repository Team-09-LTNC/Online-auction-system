<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            prefWidth="1536"
            prefHeight="960"
            stylesheets="@../../css/seller.css"
            fx:controller="com.auction.client.controller.seller.PostAuctionController">

    <!-- ================= LEFT SIDEBAR ================= -->
    <left>
        <VBox prefWidth="260"
              spacing="18"
              styleClass="sidebar">

            <padding>
                <Insets top="25" right="20" bottom="25" left="20"/>
            </padding>

            <!-- Logo -->
            <VBox spacing="2">
                <Label text="AuctionHub" styleClass="logo-title"/>
                <Label text="Đấu giá thông minh" styleClass="logo-subtitle"/>
            </VBox>

            <VBox spacing="8">

                <Button text="🏠  Trang chủ" styleClass="menu-btn"/>
                <Button text="🔔  Phiên đấu giá" styleClass="menu-btn"/>
                <Button text="👜  Sản phẩm của tôi" styleClass="menu-btn"/>

                <!-- Active -->
                <Button text="➕  Đăng sản phẩm"
                        styleClass="menu-btn-active"/>

                <Button text="☑  Quản lý sản phẩm" styleClass="menu-btn"/>
                <Button text="🧾  Đơn đã bán" styleClass="menu-btn"/>

            </VBox>

            <Separator/>

            <VBox spacing="12">

                <Label text="Danh mục" styleClass="section-sidebar-title"/>

                <Button text="◉  Tất cả" styleClass="category-btn"/>
                <Button text="📱  Điện tử" styleClass="category-btn"/>
                <Button text="🎨  Nghệ thuật" styleClass="category-btn"/>
                <Button text="🚗  Xe cộ" styleClass="category-btn"/>
                <Button text="💎  Đồ sưu tầm" styleClass="category-btn"/>
                <Button text="💍  Trang sức" styleClass="category-btn"/>

                <Hyperlink text="Xem thêm"/>

            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Bottom Post Button -->
            <Button text="+  Đăng sản phẩm&#10;Đưa sản phẩm lên đấu giá"
                    styleClass="post-big-btn"
                    prefHeight="70"
                    wrapText="true"/>
        </VBox>
    </left>

    <!-- ================= CENTER CONTENT ================= -->
    <center>

        <ScrollPane fitToWidth="true"
                    styleClass="center-scroll">

            <VBox spacing="20"
                  styleClass="main-container">

                <padding>
                    <Insets top="25" right="35" bottom="25" left="35"/>
                </padding>

                <!-- Top Bar -->
                <HBox alignment="CENTER_LEFT">

                    <Button text="← Quay lại"
                            styleClass="back-btn"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <HBox spacing="18" alignment="CENTER">

                        <Label text="🔔"/>
                        <Label text="💬"/>

                        <HBox spacing="8" alignment="CENTER">
                            <Region prefWidth="42"
                                    prefHeight="42"
                                    styleClass="avatar-placeholder"/>

                            <VBox spacing="2">
                                <Label text="Chào, Nguyễn An"
                                       styleClass="user-name"/>
                                <Label text="Seller"
                                       styleClass="user-role"/>
                            </VBox>
                        </HBox>

                    </HBox>

                </HBox>

                <!-- Page Header -->
                <VBox spacing="6">

                    <Label text="ĐĂNG SẢN PHẨM ĐẤU GIÁ"
                           styleClass="page-title"/>

                    <Label text="Điền đầy đủ thông tin để đưa sản phẩm của bạn lên sàn đấu giá."
                           styleClass="page-subtitle"/>

                </VBox>

                <!-- STEP BAR -->
                <HBox alignment="CENTER"
                      spacing="45"
                      styleClass="step-container">

                    <VBox alignment="CENTER" spacing="8">
                        <StackPane styleClass="step-active">
                            <Label text="1" styleClass="step-number-active"/>
                        </StackPane>
                        <Label text="Thông tin cơ bản"/>
                    </VBox>

                    <VBox alignment="CENTER" spacing="8">
                        <StackPane styleClass="step-inactive">
                            <Label text="2"/>
                        </StackPane>
                        <Label text="Hình ảnh"/>
                    </VBox>

                    <VBox alignment="CENTER" spacing="8">
                        <StackPane styleClass="step-inactive">
                            <Label text="3"/>
                        </StackPane>
                        <Label text="Chi tiết đấu giá"/>
                    </VBox>

                    <VBox alignment="CENTER" spacing="8">
                        <StackPane styleClass="step-inactive">
                            <Label text="4"/>
                        </StackPane>
                        <Label text="Vận chuyển"/>
                    </VBox>

                    <VBox alignment="CENTER" spacing="8">
                        <StackPane styleClass="step-inactive">
                            <Label text="5"/>
                        </StackPane>
                        <Label text="Xác nhận"/>
                    </VBox>

                </HBox>

                <!-- CARD 1 -->
                <VBox spacing="18"
                      styleClass="card">

                    <Label text="📋  Thông tin cơ bản"
                           styleClass="card-title"/>

                    <HBox spacing="20">

                        <VBox spacing="6" HBox.hgrow="ALWAYS">

                            <Label text="Tên sản phẩm *"/>

                            <TextField fx:id="txtProductName"
                                       promptText="Nhập tên sản phẩm"
                                       styleClass="modern-input"/>

                        </VBox>

                        <VBox spacing="6" HBox.hgrow="ALWAYS">

                            <Label text="Danh mục *"/>

                            <ComboBox fx:id="cbCategory"
                                      promptText="-- Chọn danh mục --"
                                      styleClass="modern-combo"
                                      maxWidth="Infinity"/>

                        </VBox>

                    </HBox>

                    <!-- Description -->
                    <VBox spacing="6">

                        <Label text="Mô tả sản phẩm *"/>

                        <VBox styleClass="editor-box">

                            <!-- Toolbar -->
                            <HBox spacing="15"
                                  styleClass="editor-toolbar">

                                <Button text="B"/>
                                <Button text="I"/>
                                <Button text="U"/>
                                <Button text="•"/>
                                <Button text="1."/>
                                <Button text="🔗"/>

                            </HBox>

                            <TextArea fx:id="txtDescription"
                                      prefRowCount="7"
                                      wrapText="true"
                                      promptText="Mô tả chi tiết về sản phẩm: tình trạng, đặc điểm, xuất xứ, v.v."
                                      styleClass="editor-area"/>

                        </VBox>

                    </VBox>

                </VBox>

                <!-- CARD 2 -->
                <VBox spacing="18"
                      styleClass="card">

                    <Label text="📄  Thông tin nhanh"
                           styleClass="card-title"/>

                    <HBox spacing="20">

                        <VBox spacing="6" HBox.hgrow="ALWAYS">

                            <Label text="Giá khởi điểm *"/>

                            <TextField fx:id="txtStartingPrice"
                                       promptText="Nhập giá"
                                       styleClass="modern-input"/>

                        </VBox>

                        <VBox spacing="6" HBox.hgrow="ALWAYS">

                            <Label text="Bước giá (Increment) *"/>

                            <TextField fx:id="txtIncrement"
                                       promptText="Nhập bước giá"
                                       styleClass="modern-input"/>

                        </VBox>

                        <VBox spacing="6" HBox.hgrow="ALWAYS">

                            <Label text="Giá mua ngay (Tùy chọn)"/>

                            <TextField fx:id="txtBuyNowPrice"
                                       promptText="Nhập giá mua ngay"
                                       styleClass="modern-input"/>

                        </VBox>

                    </HBox>

                </VBox>

                <!-- CARD 3 -->
                <VBox spacing="18"
                      styleClass="card">

                    <Label text="🕒  Thời gian đấu giá"
                           styleClass="card-title"/>

                    <HBox spacing="20">

                        <!-- Start -->
                        <VBox spacing="6" HBox.hgrow="ALWAYS">

                            <Label text="Ngày bắt đầu *"/>

                            <HBox spacing="10">

                                <DatePicker fx:id="dpStartDate"
                                            HBox.hgrow="ALWAYS"
                                            styleClass="modern-date"/>

                                <TextField fx:id="txtStartTime"
                                           promptText="14:30"
                                           prefWidth="100"
                                           styleClass="modern-input"/>

                            </HBox>

                        </VBox>

                        <!-- End -->
                        <VBox spacing="6" HBox.hgrow="ALWAYS">

                            <Label text="Thời gian kết thúc *"/>

                            <HBox spacing="10">

                                <DatePicker fx:id="dpEndDate"
                                            HBox.hgrow="ALWAYS"
                                            styleClass="modern-date"/>

                                <TextField fx:id="txtEndTime"
                                           promptText="14:30"
                                           prefWidth="100"
                                           styleClass="modern-input"/>

                            </HBox>

                        </VBox>

                    </HBox>

                    <CheckBox fx:id="chkAntiSniping"
                              text="Áp dụng gia hạn thời gian (Anti-sniping)"
                              styleClass="modern-check"/>

                    <Label text="Nếu có người đấu giá trong 10 giây cuối, thời gian sẽ được gia hạn thêm 30 giây."
                           styleClass="hint-text"/>

                </VBox>

                <!-- ACTION BUTTONS -->
                <HBox alignment="CENTER_RIGHT"
                      spacing="18">

                    <Button text="Hủy"
                            styleClass="btn-cancel"/>

                    <Button text="Tiếp tục  →"
                            styleClass="btn-next"
                            onAction="#handleSubmitAuction"/>

                </HBox>

            </VBox>

        </ScrollPane>

    </center>

    <!-- ================= RIGHT PREVIEW ================= -->
    <right>

        <VBox prefWidth="360"
              spacing="18"
              styleClass="preview-sidebar">

            <padding>
                <Insets top="30" right="25" bottom="30" left="25"/>
            </padding>

            <Label text="👁  XEM TRƯỚC SẢN PHẨM"
                   styleClass="preview-title"/>

            <VBox spacing="18"
                  styleClass="preview-card">

                <!-- Main Image -->
                <Region prefHeight="280"
                        styleClass="preview-image"/>

                <!-- Thumbnail List -->
                <HBox spacing="10">

                    <Region prefWidth="55"
                            prefHeight="55"
                            styleClass="thumb-active"/>

                    <Region prefWidth="55"
                            prefHeight="55"
                            styleClass="thumb-empty"/>

                    <Region prefWidth="55"
                            prefHeight="55"
                            styleClass="thumb-empty"/>

                    <Region prefWidth="55"
                            prefHeight="55"
                            styleClass="thumb-empty"/>

                </HBox>

                <!-- Info -->
                <VBox spacing="15">

                    <VBox spacing="4">
                        <Label text="Tên sản phẩm"
                               styleClass="preview-label"/>

                        <Label text="iPhone 15 Pro Max 512GB"
                               styleClass="preview-product-name"/>
                    </VBox>

                    <Separator/>

                    <VBox spacing="4">
                        <Label text="Danh mục"
                               styleClass="preview-label"/>

                        <Label text="Điện thoại"/>
                    </VBox>

                    <Separator/>

                    <VBox spacing="4">
                        <Label text="Giá khởi điểm"
                               styleClass="preview-label"/>

                        <Label text="28.500.000 đ"
                               styleClass="preview-price"/>
                    </VBox>

                    <Separator/>

                    <VBox spacing="4">
                        <Label text="Bước giá"
                               styleClass="preview-label"/>

                        <Label text="500.000 đ"/>
                    </VBox>

                    <Separator/>

                    <VBox spacing="4">
                        <Label text="Thời gian"
                               styleClass="preview-label"/>

                        <Label text="22/05/2024 14:30"/>
                        <Label text="đến 25/05/2024 14:30"/>
                    </VBox>

                    <Separator/>

                    <HBox alignment="CENTER_LEFT"
                          spacing="10">

                        <Label text="Gia hạn thời gian"/>

                        <Label text="Có áp dụng"
                               styleClass="tag-success"/>

                    </HBox>

                </VBox>

                <Label text="Lưu ý: Thông tin chỉ mang tính chất minh họa.&#10;Vui lòng kiểm tra lại trước khi đăng."
                       wrapText="true"
                       styleClass="preview-note"/>

            </VBox>

        </VBox>

    </right>

</BorderPane>