<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.image.ImageView?>

<HBox prefHeight="850.0" prefWidth="1200.0" spacing="0" style="-fx-background-color: #FDFBF9;" stylesheets="@../../css/seller.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.seller.PostAuctionController">

    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" HBox.hgrow="ALWAYS">
        <content>
            <VBox spacing="25.0" style="-fx-padding: 30 50 50 50;">

                <VBox spacing="5.0">
                    <Label styleClass="page-title" text="ĐĂNG SẢN PHẨM ĐẤU GIÁ" textFill="#3E2723">
                        <font><Font name="System Bold" size="24.0" /></font>
                    </Label>
                    <Label styleClass="page-subtitle" text="Vui lòng hoàn thành 5 bước dưới đây để niêm yết sản phẩm." textFill="#888888" />
                </VBox>

                <HBox alignment="CENTER" spacing="0.0" style="-fx-padding: 10 0 20 0;">
                    <VBox alignment="CENTER" spacing="5.0">
                        <StackPane styleClass="step-active"><Label styleClass="step-number-active" text="1" /></StackPane>
                        <Label style="-fx-font-size: 11;" text="Thông tin cơ bản" />
                    </VBox>
                    <Region prefWidth="50.0" style="-fx-border-color: #E8DFD8; -fx-border-width: 2 0 0 0; -fx-translate-y: -12;" />
                    <VBox alignment="CENTER" spacing="5.0">
                        <StackPane styleClass="step-inactive"><Label text="2" /></StackPane>
                        <Label style="-fx-font-size: 11; -fx-text-fill: #888888;" text="Hình ảnh" />
                    </VBox>
                    <Region prefWidth="50.0" style="-fx-border-color: #E8DFD8; -fx-border-width: 2 0 0 0; -fx-translate-y: -12;" />
                    <VBox alignment="CENTER" spacing="5.0">
                        <StackPane styleClass="step-inactive"><Label text="3" /></StackPane>
                        <Label style="-fx-font-size: 11; -fx-text-fill: #888888;" text="Chi tiết đấu giá" />
                    </VBox>
                    <Region prefWidth="50.0" style="-fx-border-color: #E8DFD8; -fx-border-width: 2 0 0 0; -fx-translate-y: -12;" />
                    <VBox alignment="CENTER" spacing="5.0">
                        <StackPane styleClass="step-inactive"><Label text="4" /></StackPane>
                        <Label style="-fx-font-size: 11; -fx-text-fill: #888888;" text="Vận chuyển" />
                    </VBox>
                    <Region prefWidth="50.0" style="-fx-border-color: #E8DFD8; -fx-border-width: 2 0 0 0; -fx-translate-y: -12;" />
                    <VBox alignment="CENTER" spacing="5.0">
                        <StackPane styleClass="step-inactive"><Label text="5" /></StackPane>
                        <Label style="-fx-font-size: 11; -fx-text-fill: #888888;" text="Xác nhận" />
                    </VBox>
                </HBox>

                <VBox spacing="15.0" styleClass="card">
                    <Label styleClass="card-title" text="📄 Bước 1 &amp; 2: Thông tin &amp; Hình ảnh" />
                    <TextField fx:id="txtProductName" promptText="Tên sản phẩm *" styleClass="modern-input" />
                    <ComboBox fx:id="cbCategory" maxWidth="Infinity" promptText="-- Chọn danh mục --" styleClass="modern-combo" />
                    <TextArea fx:id="txtDescription" prefHeight="100.0" promptText="Mô tả chi tiết sản phẩm..." styleClass="editor-area" wrapText="true" />
                    <Button fx:id="btnUploadImage" onAction="#handleUploadImage" prefHeight="40.0" style="-fx-background-color: #F8F9FA; -fx-border-color: #DDD; -fx-border-radius: 8;" text="📸 Tải lên ảnh sản phẩm" maxWidth="Infinity" />
                </VBox>

                <VBox spacing="15.0" styleClass="card">
                    <Label styleClass="card-title" text="🔨 Bước 3: Chi tiết đấu giá" />
                    <HBox spacing="20.0">
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <Label style="-fx-font-weight: bold;" text="Giá khởi điểm *" />
                            <TextField fx:id="txtStartingPrice" promptText="đ" styleClass="modern-input" />
                        </VBox>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <Label style="-fx-font-weight: bold;" text="Bước giá (Increment) *" />
                            <TextField fx:id="txtIncrement" promptText="đ" styleClass="modern-input" />
                        </VBox>
                    </HBox>
                    <HBox spacing="20.0">
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <Label style="-fx-font-weight: bold;" text="Ngày bắt đầu" />
                            <DatePicker fx:id="dpStartDate" maxWidth="Infinity" styleClass="modern-date" />
                        </VBox>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <Label style="-fx-font-weight: bold;" text="Ngày kết thúc" />
                            <DatePicker fx:id="dpEndDate" maxWidth="Infinity" styleClass="modern-date" />
                        </VBox>
                    </HBox>
                    <CheckBox fx:id="chkAntiSniping" text="Áp dụng Anti-sniping (Tự động gia hạn 30s khi có bid cuối)" />
                </VBox>

                <VBox spacing="15.0" styleClass="card">
                    <Label styleClass="card-title" text="🚚 Bước 4: Vận chuyển" />
                    <HBox spacing="20.0">
                        <ComboBox fx:id="cbShippingMethod" HBox.hgrow="ALWAYS" maxWidth="Infinity" promptText="Hình thức giao hàng" styleClass="modern-combo" />
                        <TextField fx:id="txtShippingFee" promptText="Phí vận chuyển dự kiến (đ)" styleClass="modern-input" HBox.hgrow="ALWAYS" />
                    </HBox>
                    <TextArea fx:id="txtShippingNote" prefHeight="60.0" promptText="Ghi chú vận chuyển (VD: Chỉ ship trong giờ hành chính...)" styleClass="editor-area" />
                </VBox>

                <VBox spacing="15.0" styleClass="card" style="-fx-background-color: #FFF9F9; -fx-border-color: #7A1B28;">
                    <Label styleClass="card-title" text="✅ Bước 5: Xác nhận &amp; Đăng tải" />
                    <CheckBox text="Tôi cam đoan thông tin sản phẩm là chính xác 100%." wrapText="true" />
                    <CheckBox text="Tôi đồng ý với các điều khoản và phí niêm yết của AuctionHub." wrapText="true" />
                </VBox>

                <HBox alignment="CENTER_RIGHT" spacing="20.0">
                    <Button prefWidth="100.0" styleClass="btn-cancel" text="Hủy bỏ" />
                    <Button onAction="#handleSubmitAuction" prefHeight="45.0" prefWidth="220.0" styleClass="btn-next" text="ĐĂNG ĐẤU GIÁ NGAY" />
                </HBox>
            </VBox>
        </content>
    </ScrollPane>

    <VBox prefWidth="350.0" spacing="20.0" style="-fx-background-color: #FFFFFF; -fx-padding: 25; -fx-border-color: #EEEEEE; -fx-border-width: 0 0 0 1;">
        <Label styleClass="preview-title" text="👁 XEM TRƯỚC SẢN PHẨM" />

        <StackPane prefHeight="200.0" style="-fx-background-color: #F8F9FA; -fx-background-radius: 10;">
            <ImageView fx:id="imgPreview" fitWidth="300.0" fitHeight="180.0" pickOnBounds="true" preserveRatio="true" />
        </StackPane>

        <VBox spacing="15.0">
            <VBox spacing="2.0">
                <Label styleClass="preview-label" text="Tên sản phẩm" />
                <Label fx:id="lblPreviewName" styleClass="preview-product-name" text="Tên sản phẩm mẫu" wrapText="true" />
            </VBox>
            <VBox spacing="2.0">
                <Label styleClass="preview-label" text="Giá khởi điểm" />
                <Label fx:id="lblPreviewPrice" styleClass="preview-price" text="0 đ" />
            </VBox>
            <VBox spacing="2.0">
                <Label styleClass="preview-label" text="Trạng thái vận chuyển" />
                <Label style="-fx-font-size: 13;" text="Sẵn sàng giao hàng" textFill="#1A0F0A" />
            </VBox>
        </VBox>
        <Region VBox.vgrow="ALWAYS" />
        <Label style="-fx-text-fill: #A0968C; -fx-font-size: 11; -fx-text-alignment: center;" text="Lưu ý: Mọi thay đổi sẽ được cập nhật trực tiếp tại đây." wrapText="true" />
    </VBox>
</HBox>