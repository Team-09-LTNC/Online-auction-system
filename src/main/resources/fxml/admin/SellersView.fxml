<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<!--
    SellersView.fxml
    Controller: com.auction.client.controller.SellersViewController
    Danh sách người bán — admin có thể xoá hoặc khoá/mở khoá tài khoản
-->
<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.auction.client.controller.admin.SellersViewController"
           maxWidth="Infinity" maxHeight="Infinity"
           style="-fx-background-color: #F7F2EC; -fx-padding: 24;">

    <VBox spacing="16" maxHeight="Infinity">

        <!-- Tiêu đề -->
        <HBox alignment="CENTER_LEFT" spacing="12" VBox.vgrow="NEVER">
            <Region style="-fx-background-color: #8F1D2C;
                           -fx-pref-width: 4px; -fx-pref-height: 22px;"/>
            <Label text="Danh sách người bán"
                   style="-fx-text-fill: #211713; -fx-font-size: 18px;
                          -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblSellerCount" text="0 người bán"
                   style="-fx-text-fill: #5E4A42; -fx-font-size: 12px;"/>
        </HBox>

        <!-- Thanh công cụ -->
        <HBox spacing="10" alignment="CENTER_LEFT" VBox.vgrow="NEVER">
            <TextField fx:id="tfSearch"
                       promptText="🔍  Tìm theo username hoặc họ tên..."
                       onKeyReleased="#handleSearch"
                       style="-fx-background-color: #FFFCF8;
                              -fx-border-color: #E8DCD2; -fx-border-width: 1px;
                              -fx-border-radius: 6px; -fx-background-radius: 6px;
                              -fx-padding: 8 14 8 14; -fx-font-size: 13px;
                              -fx-pref-width: 280px; -fx-prompt-text-fill: #B6A79D;"/>

            <ComboBox fx:id="cbStatusFilter"
                      onAction="#handleFilter"
                      style="-fx-background-color: #FFFCF8;
                             -fx-border-color: #E8DCD2; -fx-border-width: 1px;
                             -fx-border-radius: 6px; -fx-background-radius: 6px;
                             -fx-font-size: 13px; -fx-pref-width: 150px;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="btnToggleLock" text="🔒  Khoá tài khoản"
                    onAction="#handleToggleLock" disable="true"
                    style="-fx-background-color: #8F1D2C; -fx-text-fill: white;
                           -fx-font-size: 13px; -fx-font-weight: bold;
                           -fx-padding: 8 18 8 18; -fx-border-radius: 6px;
                           -fx-background-radius: 6px; -fx-cursor: hand;
                           -fx-border-width: 0;"/>

            
        </HBox>

        <!-- Bảng dữ liệu -->
        <TableView fx:id="sellerTable"
                   VBox.vgrow="ALWAYS"
                   maxHeight="Infinity"
                   onMouseClicked="#handleTableClick"
                   style="-fx-background-color: #FFFCF8;
                          -fx-border-color: #E8DCD2; -fx-border-width: 1px;
                          -fx-border-radius: 10px; -fx-background-radius: 10px;">
            <columns>
                <TableColumn fx:id="colUsername" text="Tên đăng nhập" prefWidth="220"/>
                <TableColumn fx:id="colFullname" text="Họ và tên"     prefWidth="260"/>
                <TableColumn fx:id="colStatus"   text="Trạng thái"    prefWidth="160"/>
                <TableColumn fx:id="colLockUntil" text="Mở lại lúc"    prefWidth="180"/>
            </columns>
            <placeholder>
                <Label text="Chưa có người bán nào"
                       style="-fx-text-fill: #B6A79D; -fx-font-size: 13px;"/>
            </placeholder>
        </TableView>

    </VBox>

</StackPane>
