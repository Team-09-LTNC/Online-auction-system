<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  ════════════════════════════════════════════════════
  AdminLayout 
  Mô tả      : Sidebar + Header + ContentPane động.
                Các màn hình con được load vào #contentPane
  ════════════════════════════════════════════════════
-->

<BorderPane prefHeight="860" prefWidth="1400" style="-fx-background-color: #EDE6DF;" stylesheets="@/css/admin.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.admin.AdminLayoutController">

    <!-- ══════════════════════════════════
         SIDEBAR
         ══════════════════════════════════ -->
    <left>
        <VBox prefWidth="248" styleClass="admin-sidebar">

            <!-- ─ Logo / Brand ─ -->
            <VBox spacing="6" styleClass="admin-sidebar-header">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <VBox spacing="0">
                        <HBox spacing="0">
                            <Label styleClass="admin-logo-primary" text="AUCTION" />
                            <Label styleClass="admin-logo-accent" text="HUB" />
                        </HBox>
                    </VBox>
                    <VBox alignment="CENTER" styleClass="admin-badge">
                        <Label styleClass="admin-badge-label" text="ADMIN" />
                    </VBox>
                </HBox>
            </VBox>

            <!-- ─ Navigation ─ -->
            <ScrollPane fitToWidth="true" styleClass="admin-scroll" VBox.vgrow="ALWAYS">
                <VBox alignment="CENTER_LEFT" spacing="5.0" style="-fx-padding: 10 0 10 0;">

                    <Label styleClass="admin-nav-section" text="TỔNG QUAN" />
                    <Button fx:id="btnDashboard" onAction="#navigate" styleClass="admin-nav-item, admin-nav-item-active" text="📊  Dashboard" />

                    <Region style="-fx-pref-height:6px;" />
                    <Region styleClass="admin-sidebar-divider" />
                    <Region style="-fx-pref-height:6px;" />

                    <Label styleClass="admin-nav-section" text="ĐẤU GIÁ" />
                    <Button fx:id="btnAuctions" onAction="#navigate" styleClass="admin-nav-item" text="🔨  Phiên đấu giá" />

                    <Region style="-fx-pref-height:6px;" />
                    <Region styleClass="admin-sidebar-divider" />
                    <Region style="-fx-pref-height:6px;" />

                    <Label styleClass="admin-nav-section" text="NGƯỜI DÙNG" />
                    <Button fx:id="btnBidders" onAction="#navigate" styleClass="admin-nav-item" text="👥  Quản lý Bidders" />
               <Button fx:id="btnSellers" mnemonicParsing="false" onAction="#navigate" styleClass="admin-nav-item" text="👥  Quản lý Sellers" />

                    <Region style="-fx-pref-height:6px;" />
                    <Region styleClass="admin-sidebar-divider" />
                    <Region style="-fx-pref-height:6px;" />

                    <Label styleClass="admin-nav-section" text="TÀI CHÍNH" />
                    <Button fx:id="btnTransactions" onAction="#navigate" styleClass="admin-nav-item" text="💰  Giao dịch" />
                    <Button fx:id="btnInvoices" onAction="#navigate" styleClass="admin-nav-item" text="📑  Hoá đơn" />

                    <Region style="-fx-pref-height:6px;" />
                    <Region styleClass="admin-sidebar-divider" />

                </VBox>
            </ScrollPane>

            <!-- ─ Admin Footer ─ -->
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="admin-sidebar-footer">
                <StackPane alignment="CENTER" style="-fx-background-color:#8B2C2C; -fx-background-radius:20px;                                   -fx-pref-width:36px; -fx-pref-height:36px;">
                    <Label style="-fx-text-fill:#F0EAE4; -fx-font-size:12px;                                            -fx-font-weight:bold;" text="SA" />
                </StackPane>
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label fx:id="lblAdminName" style="-fx-text-fill:#F0EAE4; -fx-font-size:13px;                                   -fx-font-weight:bold;" text="Super Admin" />
                    <Label style="-fx-text-fill:#5C3D30; -fx-font-size:11px;                                   " text="admin@auctionhub.vn" />
                </VBox>
                <Button fx:id="logOut" onAction="#handleLogout" style="-fx-text-fill:#5C3D30; -fx-font-size:15px;" styleClass="btn-admin-ghost" text="⏻" />
            </HBox>
        </VBox>
    </left>

    <!-- ══════════════════════════════════
         CENTER  (Header + dynamic content)
         ══════════════════════════════════ -->
    <center>
      <StackPane fx:id="contentPane" style="-fx-background-color: #EDE6DF;">
         <children>
              <VBox>
      
                  <!-- Top Header -->
                  <HBox alignment="CENTER_LEFT" spacing="14" styleClass="admin-header" VBox.vgrow="NEVER">
      
                    <!-- Hamburger (collapse sidebar) -->
                    <!--Sau có thể thêm onAction="#toggleSidebar đang cmt trong ctrler" -->
                      <Button style="-fx-font-size:17px;" styleClass="btn-admin-ghost" text="☰" />
                        
                      <VBox alignment="CENTER_LEFT" spacing="1" HBox.hgrow="ALWAYS">
                          <Label fx:id="lblPageTitle" styleClass="admin-page-title" text="Dashboard" />
                          <!-- Breadcrumb -->
                          <HBox alignment="BOTTOM_LEFT" spacing="4">
                              <Label styleClass="admin-breadcrumb" text="Admin" />
                              <Label styleClass="admin-breadcrumb" text="›" />
                              <Label fx:id="lblBreadcrumb" styleClass="admin-breadcrumb-active" text="Dashboard" />
                          </HBox>
                      </VBox>
      
                      <!-- Global search -->
                      <TextField fx:id="globalSearch" promptText="🔍  Tìm người dùng, lot, giao dịch..." styleClass="admin-search" />
                  </HBox>
              </VBox>
         </children>
      </StackPane>
    </center>

</BorderPane>
