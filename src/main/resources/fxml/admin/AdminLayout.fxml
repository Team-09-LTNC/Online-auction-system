<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  ════════════════════════════════════════════════════
  Giao diện AdminLayout
  Mô tả      : Thanh bên + tiêu đề + vùng nội dung động.
                Các màn hình con được tải vào #contentPane
  ════════════════════════════════════════════════════
-->

<BorderPane prefHeight="860" prefWidth="1400" style="-fx-background-color: #F7F2EC;" stylesheets="@/css/admin.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.admin.AdminLayoutController">

    <!-- ══════════════════════════════════
         THANH BÊN
         ══════════════════════════════════ -->
    <left>
        <VBox prefWidth="248" styleClass="admin-sidebar">

            <!-- ─ Logo / Thương hiệu ─ -->
            <VBox spacing="6" styleClass="admin-sidebar-header">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <VBox spacing="0">
                        <HBox spacing="0">
                            <Label styleClass="admin-logo-primary" text="AUCTION" />
                            <Label styleClass="admin-logo-accent" text="HUB" />
                        </HBox>
                    </VBox>
                    <VBox alignment="CENTER" styleClass="admin-badge">
                        <Label styleClass="admin-badge-label" text="ADMIN" />
                    </VBox>
                </HBox>
            </VBox>

            <!-- ─ Điều hướng ─ -->
            <ScrollPane fitToWidth="true" styleClass="admin-scroll" VBox.vgrow="ALWAYS">
                <VBox alignment="CENTER_LEFT" spacing="5.0" style="-fx-padding: 10 8 10 8;">

                    <Label styleClass="admin-nav-section" text="TỔNG QUAN" />
                    <Button fx:id="btnDashboard" onAction="#navigate" styleClass="admin-nav-item, admin-nav-item-active" text="📊  Dashboard" />

                    <Region style="-fx-pref-height:6px;" />
                    <Region styleClass="admin-sidebar-divider" />
                    <Region style="-fx-pref-height:6px;" />

                    <Label styleClass="admin-nav-section" text="ĐẤU GIÁ" />
                    <Button fx:id="btnAuctions" onAction="#navigate" styleClass="admin-nav-item" text="🔨  Phiên đấu giá" />
                    <Button fx:id="btnProducts" onAction="#navigate" styleClass="admin-nav-item" text="📦  Duyệt sản phẩm" />

                    <Region style="-fx-pref-height:6px;" />
                    <Region styleClass="admin-sidebar-divider" />
                    <Region style="-fx-pref-height:6px;" />

                    <Label styleClass="admin-nav-section" text="NGƯỜI DÙNG" />
                    <Button fx:id="btnBidders" onAction="#navigate" styleClass="admin-nav-item" text="👥  Quản lý Bidders" />
               <Button fx:id="btnSellers" mnemonicParsing="false" onAction="#navigate" styleClass="admin-nav-item" text="👥  Quản lý Sellers" />

                    <Region style="-fx-pref-height:6px;" />
                    <Region styleClass="admin-sidebar-divider" />
                    <Region style="-fx-pref-height:6px;" />

                    <Label styleClass="admin-nav-section" text="TÀI CHÍNH" />
                    <Button fx:id="btnTransactions" onAction="#navigate" styleClass="admin-nav-item" text="💰  Giao dịch" />
                    <Button fx:id="btnInvoices" onAction="#navigate" styleClass="admin-nav-item" text="📑  Hoá đơn" />

                    <Region style="-fx-pref-height:6px;" />
                    <Region styleClass="admin-sidebar-divider" />

                </VBox>
            </ScrollPane>

            <!-- ─ Chân trang quản trị ─ -->
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="admin-sidebar-footer">
                <StackPane alignment="CENTER" style="-fx-background-color:#8F1D2C; -fx-background-radius:20px;                                   -fx-pref-width:36px; -fx-pref-height:36px;">
                    <Label style="-fx-text-fill:#FFFCF8; -fx-font-size:12px;                                            -fx-font-weight:bold;" text="SA" />
                </StackPane>
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label fx:id="lblAdminName" style="-fx-text-fill:#211713; -fx-font-size:13px;                                   -fx-font-weight:bold;" text="Super Admin" />
                    <Label style="-fx-text-fill:#927F75; -fx-font-size:11px;                                   " text="admin@auctionhub.vn" />
                </VBox>
                <Button fx:id="logOut" onAction="#handleLogout" styleClass="btn-admin-ghost">
                    <graphic>
                        <Label alignment="CENTER" prefWidth="30.0" style="-fx-font-family: 'Segoe UI Emoji'; -fx-font-size: 16;" text="🚪" />
                    </graphic>
                </Button>
            </HBox>
        </VBox>
    </left>

    <!-- ══════════════════════════════════
         TRUNG TÂM (tiêu đề + nội dung động)
         ══════════════════════════════════ -->
    <center>
      <StackPane fx:id="contentPane" style="-fx-background-color: #F7F2EC;">
         <children>
              <VBox>
      
                  <!-- Tiêu đề trên cùng -->
                  <HBox alignment="CENTER_LEFT" spacing="14" styleClass="admin-header" VBox.vgrow="NEVER">
      
                    <!-- Nút thu gọn thanh bên -->
                    <!-- Sau có thể thêm onAction="#toggleSidebar" đang ghi chú trong bộ điều khiển -->
                      <Button style="-fx-font-size:17px;" styleClass="btn-admin-ghost" text="☰" />
                        
                      <VBox alignment="CENTER_LEFT" spacing="1" HBox.hgrow="ALWAYS">
                          <Label fx:id="lblPageTitle" styleClass="admin-page-title" text="Dashboard" />
                          <!-- Điều hướng phân cấp -->
                          <HBox alignment="BOTTOM_LEFT" spacing="4">
                              <Label styleClass="admin-breadcrumb" text="Admin" />
                              <Label styleClass="admin-breadcrumb" text="›" />
                              <Label fx:id="lblBreadcrumb" styleClass="admin-breadcrumb-active" text="Dashboard" />
                          </HBox>
                      </VBox>
                  </HBox>
              </VBox>
         </children>
      </StackPane>
    </center>

</BorderPane>
