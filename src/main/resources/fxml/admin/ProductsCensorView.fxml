<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<!--
    ProductsCensorView.fxml
    Controller: com.auction.client.controller.admin.ProductsCensorController
    Danh sách sản phẩm chờ duyệt — admin có thể duyệt hoặc xoá
-->
<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.auction.client.controller.admin.ProductsCensorController"
           maxWidth="Infinity" maxHeight="Infinity"
           style="-fx-background-color: #EDE6DF; -fx-padding: 24;">

    <VBox spacing="16" maxHeight="Infinity">

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="12" VBox.vgrow="NEVER">
            <Region style="-fx-background-color: #8B2C2C;
                           -fx-pref-width: 4px; -fx-pref-height: 22px;"/>
            <Label text="Sản phẩm chờ duyệt"
                   style="-fx-text-fill: #1A0F0A; -fx-font-size: 18px;
                          -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblProductCount" text="0 sản phẩm"
                   style="-fx-text-fill: #5C3D30; -fx-font-size: 12px;"/>
        </HBox>

        <!-- Toolbar -->
        <HBox spacing="10" alignment="CENTER_LEFT" VBox.vgrow="NEVER">
            <TextField fx:id="tfSearch"
                       promptText="🔍  Tìm theo tên, seller ID, phân loại..."
                       onKeyReleased="#handleSearch"
                       style="-fx-background-color: #F0EAE4;
                              -fx-border-color: #C8AFA0; -fx-border-width: 1px;
                              -fx-border-radius: 6px; -fx-background-radius: 6px;
                              -fx-padding: 8 14 8 14; -fx-font-size: 13px;
                              -fx-pref-width: 300px; -fx-prompt-text-fill: #C8AFA0;"/>
            <ComboBox fx:id="cbCategory"
                      promptText="Phân loại"
                      onAction="#handleFilter"
                      style="-fx-background-color: #F0EAE4;
                             -fx-border-color: #C8AFA0; -fx-border-width: 1px;
                             -fx-border-radius: 6px; -fx-background-radius: 6px;
                             -fx-font-size: 13px; -fx-pref-width: 150px;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnApprove" text="✓  Duyệt"
                    onAction="#handleApprove" disable="true"
                    style="-fx-background-color: #27AE60; -fx-text-fill: white;
                           -fx-font-size: 13px; -fx-font-weight: bold;
                           -fx-padding: 8 18 8 18; -fx-border-radius: 6px;
                           -fx-background-radius: 6px; -fx-cursor: hand;
                           -fx-border-width: 0;"/>
            <Button fx:id="btnDelete" text="🗑  Xoá"
                    onAction="#handleDelete" disable="true"
                    style="-fx-background-color: #C0392B; -fx-text-fill: white;
                           -fx-font-size: 13px; -fx-font-weight: bold;
                           -fx-padding: 8 18 8 18; -fx-border-radius: 6px;
                           -fx-background-radius: 6px; -fx-cursor: hand;
                           -fx-border-width: 0;"/>
        </HBox>

        <!-- Table -->
        <TableView fx:id="productTable"
                   VBox.vgrow="ALWAYS"
                   maxHeight="Infinity"
                   onMouseClicked="#handleTableClick"
                   style="-fx-background-color: #F0EAE4;
                          -fx-border-color: #C8AFA0; -fx-border-width: 1px;
                          -fx-border-radius: 10px; -fx-background-radius: 10px;">
            <columns>
                <TableColumn fx:id="colProductId"   text="ID Sản phẩm"   prefWidth="120"/>
                <TableColumn fx:id="colSellerId"    text="Seller ID"      prefWidth="110"/>
                <TableColumn fx:id="colName"        text="Tên sản phẩm"  prefWidth="180"/>
                <TableColumn fx:id="colDescription" text="Mô tả"         prefWidth="200"/>
                <TableColumn fx:id="colCategory"    text="Phân loại"     prefWidth="110"/>
                <TableColumn fx:id="colStartPrice"  text="Giá ban đầu"   prefWidth="120"/>
                <TableColumn fx:id="colImage"       text="Hình ảnh"      prefWidth="100"/>
            </columns>
            <placeholder>
                <Label text="Không có sản phẩm nào chờ duyệt"
                       style="-fx-text-fill: #C8AFA0; -fx-font-size: 13px;"/>
            </placeholder>
        </TableView>

    </VBox>

</StackPane>
