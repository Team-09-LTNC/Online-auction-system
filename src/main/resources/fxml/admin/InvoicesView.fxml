<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<!--
    InvoicesView.fxml
    Controller: com.auction.client.controller.admin.InvoicesController
    Danh sách sản phẩm đã thanh toán (status = PAID)
-->
<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.auction.client.controller.admin.InvoicesController"
           maxWidth="Infinity" maxHeight="Infinity"
           style="-fx-background-color: #F7F2EC; -fx-padding: 24;">

    <VBox spacing="16" maxHeight="Infinity">

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="12" VBox.vgrow="NEVER">
            <Region style="-fx-background-color: #8F1D2C;
                           -fx-pref-width: 4px; -fx-pref-height: 22px;"/>
            <Label text="Hoá đơn đã thanh toán"
                   style="-fx-text-fill: #211713; -fx-font-size: 18px;
                          -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblInvoiceCount" text="0 hoá đơn"
                   style="-fx-text-fill: #5E4A42; -fx-font-size: 12px;"/>
        </HBox>

        <!-- Toolbar -->
        <HBox spacing="10" alignment="CENTER_LEFT" VBox.vgrow="NEVER">
            <TextField fx:id="tfSearch"
                       promptText="🔍  Tìm theo ID, tên sản phẩm, seller, winner..."
                       onKeyReleased="#handleSearch"
                       style="-fx-background-color: #FFFCF8;
                              -fx-border-color: #E8DCD2; -fx-border-width: 1px;
                              -fx-border-radius: 6px; -fx-background-radius: 6px;
                              -fx-padding: 8 14 8 14; -fx-font-size: 13px;
                              -fx-pref-width: 340px; -fx-prompt-text-fill: #B6A79D;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblTotalRevenue" text="Tổng: ₫ 0"
                   style="-fx-text-fill: #8F1D2C; -fx-font-size: 14px;
                          -fx-font-weight: bold;"/>
        </HBox>

        <!-- Table -->
        <TableView fx:id="invoiceTable"
                   VBox.vgrow="ALWAYS"
                   maxHeight="Infinity"
                   style="-fx-background-color: #FFFCF8;
                          -fx-border-color: #E8DCD2; -fx-border-width: 1px;
                          -fx-border-radius: 10px; -fx-background-radius: 10px;">
            <columns>
                <TableColumn fx:id="colProductId"  text="ID Sản phẩm"  prefWidth="130"/>
                <TableColumn fx:id="colName"       text="Tên sản phẩm" prefWidth="190"/>
                <TableColumn fx:id="colAuctionId"  text="Auction ID"   prefWidth="120"/>
                <TableColumn fx:id="colSellerId"   text="Seller ID"    prefWidth="120"/>
                <TableColumn fx:id="colWinnerId"   text="Winner ID"    prefWidth="120"/>
                <TableColumn fx:id="colFinalPrice" text="Giá cuối (₫)" prefWidth="130"/>
            </columns>
            <placeholder>
                <Label text="Chưa có hoá đơn nào"
                       style="-fx-text-fill: #B6A79D; -fx-font-size: 13px;"/>
            </placeholder>
        </TableView>

    </VBox>

</StackPane>
