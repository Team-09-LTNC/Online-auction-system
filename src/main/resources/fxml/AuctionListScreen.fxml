<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #f4f1ee;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.AuctionListController">

    <top>
        <HBox alignment="CENTER_RIGHT" prefHeight="70.0" prefWidth="900.0" style="-fx-background-color: #631b1b;" BorderPane.alignment="CENTER">
            <children>
                <Label text="DANH SÁCH PHIÊN ĐẤU GIÁ" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                    <HBox.margin>
                        <Insets right="220.0" />
                    </HBox.margin>
                </Label>
                <Button fx:id="btnLogout" mnemonicParsing="false" style="-fx-background-color: #f4f1ee; -fx-text-fill: #631b1b;" text="Đăng xuất">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                    <HBox.margin>
                        <Insets right="20.0" />
                    </HBox.margin>
                </Button>
            </children>
        </HBox>
    </top>

    <center>
        <VBox prefHeight="200.0" prefWidth="100.0" spacing="15.0" BorderPane.alignment="CENTER">
            <children>
                <TableView fx:id="auctionTable" prefHeight="450.0" prefWidth="860.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colName" prefWidth="300.0" text="Sản phẩm" />
                        <TableColumn fx:id="colPrice" prefWidth="180.0" text="Giá hiện tại" />
                        <TableColumn fx:id="colStatus" prefWidth="150.0" text="Trạng thái" />
                        <TableColumn fx:id="colTime" prefWidth="200.0" text="Thời gian còn lại" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <HBox alignment="CENTER_RIGHT" prefHeight="60.0" prefWidth="200.0" spacing="20.0">
                    <children>
                        <Label text="Chọn một phiên để tham gia:" textFill="#631b1b">
                            <font>
                                <Font name="System Italic" size="14.0" />
                            </font>
                        </Label>
                        <Button fx:id="btnEnterAuction" mnemonicParsing="false" onAction="#onEnterAuctionClick" prefHeight="40.0" prefWidth="150.0" style="-fx-background-color: #631b1b; -fx-text-fill: white; -fx-background-radius: 20;" text="VÀO ĐẤU GIÁ">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Button>
                    </children>
                    <padding>
                        <Insets bottom="10.0" right="10.0" />
                    </padding>
                </HBox>
            </children>
            <BorderPane.margin>
                <Insets bottom="10.0" left="20.0" right="20.0" top="20.0" />
            </BorderPane.margin>
        </VBox>
    </center>
</BorderPane>