<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<!-- Đặt prefWidth để nó khớp với chỗ đứng bên phải trong Dashboard -->
<VBox prefWidth="300.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 20; -fx-padding: 20;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">

    <!-- Tiêu đề "Hoạt động gần đây" -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="📈" style="-fx-font-size: 16;" />
        <Label text="Hoạt động gần đây" textFill="#333333">
            <font><Font name="System Bold" size="16.0" /></font>
        </Label>
        <VBox.margin><Insets bottom="15.0" /></VBox.margin>
    </HBox>

    <!-- Danh sách cuộn -->
    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
        <content>
            <VBox spacing="20.0">

                <!-- HOẠT ĐỘNG 1 -->
                <HBox spacing="10.0">
                    <!-- dùng hình tròn đỏ làm Avatar -->
                    <Circle fill="#7A1B28" radius="15.0" />
                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                        <Label text="MinhTrung89 đã đặt giá" textFill="#333333" wrapText="true">
                            <font><Font name="System Bold" size="12.0" /></font>
                        </Label>
                        <Label text="28.500.000 đ cho iPhone 15..." textFill="#555555" wrapText="true">
                            <font><Font size="12.0" /></font>
                        </Label>
                        <Label text="1 phút trước" textFill="#888888">
                            <font><Font size="11.0" /></font>
                        </Label>
                    </VBox>
                </HBox>

                <!-- HOẠT ĐỘNG 2 -->
                <HBox spacing="10.0">
                    <Circle fill="#DDDDDD" radius="15.0" />
                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                        <Label text="ArtLover đã đặt giá" textFill="#333333" wrapText="true">
                            <font><Font name="System Bold" size="12.0" /></font>
                        </Label>
                        <Label text="15.200.000 đ cho Tranh sơn dầu..." textFill="#555555" wrapText="true">
                            <font><Font size="12.0" /></font>
                        </Label>
                        <Label text="2 phút trước" textFill="#888888">
                            <font><Font size="11.0" /></font>
                        </Label>
                    </VBox>
                </HBox>

                <!-- Thêm hoạt động 3, 4 tương tự... -->

            </VBox>
        </content>
    </ScrollPane>

    <!-- Nút "Xem tất cả hoạt động ->" ở dưới đáy -->
    <Label text="Xem tất cả hoạt động →" textFill="#7A1B28" alignment="CENTER" maxWidth="Infinity" style="-fx-cursor: hand;">
        <font><Font size="12.0" /></font>
        <VBox.margin><Insets top="15.0" /></VBox.margin>
    </Label>

</VBox>