<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="700.0" prefWidth="900.0" spacing="20.0" style="-fx-background-color: #FDFBF9; -fx-padding: 30;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.client.controller.components.WalletController">

    <VBox spacing="5.0">
        <Label text="VÍ ĐIỆN TỬ AUCTIONHUB" textFill="#7A1B28" style="-fx-font-weight: bold; -fx-font-size: 22;" />
        <Label text="Quản lý số dư, nạp rút tiền và theo dõi lịch sử giao dịch của bạn." textFill="#888888" style="-fx-font-size: 13;" />
    </VBox>

    <HBox spacing="20.0">
        <VBox prefWidth="400.0" style="-fx-background-color: #FFF5E1; -fx-background-radius: 15; -fx-border-color: #E8D8C8; -fx-border-radius: 15; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
            <Label text="SỐ DƯ KHẢ DỤNG" textFill="#888888" style="-fx-font-size: 12; -fx-font-weight: bold;" />

            <Label fx:id="lblBalance" text="0 đ" textFill="#3E2723">
                <font><Font name="System Bold" size="32.0" /></font>
                <padding><Insets top="10.0" bottom="15.0" /></padding>
            </Label>

            <HBox spacing="15.0">
                <Button onAction="#handleDeposit" prefHeight="35.0" prefWidth="120.0" text="💰 Nạp tiền"
                        style="-fx-background-color: #3E2723; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" />

                <Button onAction="#handleWithdraw" prefHeight="35.0" prefWidth="120.0" text="💸 Rút tiền"
                        style="-fx-background-color: transparent; -fx-text-fill: #3E2723; -fx-border-color: #3E2723; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-font-weight: bold; -fx-cursor: hand;" />
            </HBox>
        </VBox>

        <VBox alignment="CENTER" prefWidth="440.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-border-color: #EEEEEE;">
            <Label text="Nhập số tiền muốn Giao dịch (đ)" style="-fx-font-weight: bold; -fx-font-size: 14;" />
            <TextField fx:id="txtAmount" prefHeight="45.0" promptText="Ví dụ: 500.000"
                       style="-fx-background-radius: 10; -fx-alignment: center; -fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #B23A48; -fx-margin: 15 0;">
                <VBox.margin><Insets top="15.0" bottom="15.0" /></VBox.margin>
            </TextField>
            <Label text="* Hỗ trợ thanh toán nội địa và ví điện tử liên kết." textFill="#A0968C" style="-fx-font-size: 11;" />
        </VBox>
    </HBox>

    <VBox VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-border-color: #EEEEEE;">
        <Label text="📜 Lịch sử biến động số dư" style="-fx-font-weight: bold; -fx-font-size: 16; -fx-padding: 0 0 10 0;" />
        <ListView fx:id="lvTransactionHistory" VBox.vgrow="ALWAYS" style="-fx-background-radius: 10; -fx-border-color: transparent;" />
    </VBox>
</VBox>
