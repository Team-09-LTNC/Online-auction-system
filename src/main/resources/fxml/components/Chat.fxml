<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="700.0" prefWidth="800.0" spacing="18.0"
      style="-fx-background-color: #FDFBF9; -fx-padding: 24;"
      stylesheets="@../../css/style.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.client.controller.components.ChatController">

    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <VBox spacing="4.0">
            <Label text="Thông báo" style="-fx-font-weight: bold; -fx-font-size: 26;" textFill="#3E2723" />
            <Label text="Các cập nhật phiên đấu giá và thanh toán của bạn."
                   style="-fx-font-size: 13;" textFill="#7D6E6A" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="lblNotificationCount" text="0 thông báo"
               style="-fx-background-color: #F2E8E4; -fx-background-radius: 20; -fx-padding: 8 13; -fx-font-weight: bold;"
               textFill="#7A1B28" />
    </HBox>

    <StackPane VBox.vgrow="ALWAYS"
               style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 12; -fx-border-color: #EEE5DE; -fx-border-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(62,39,35,0.06), 16, 0, 0, 5);">
        <ListView fx:id="lvChatMessages" styleClass="notification-list" />
        <VBox fx:id="emptyNotificationState" alignment="CENTER" mouseTransparent="true" spacing="10.0">
            <padding>
                <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
            </padding>
            <Label text="💬" style="-fx-font-family: 'Segoe UI Emoji'; -fx-font-size: 34;" />
            <Label text="Chưa có thông báo mới"
                   style="-fx-font-size: 17; -fx-font-weight: bold;" textFill="#3E2723" />
            <Label text="Thông báo chiến thắng, thanh toán và cập nhật bán hàng sẽ xuất hiện tại đây."
                   maxWidth="420.0" style="-fx-font-size: 13; -fx-text-alignment: center;"
                   textFill="#7D6E6A" wrapText="true" />
        </VBox>
    </StackPane>

</VBox>
