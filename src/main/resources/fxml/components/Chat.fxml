<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="700.0" prefWidth="800.0" spacing="10.0" style="-fx-background-color: #FDFBF9; -fx-padding: 20;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.components.ChatController">

    <Label text="THÔNG BÁO" style="-fx-font-weight: bold; -fx-font-size: 20;" textFill="#7A1B28" />

    <VBox VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15; -fx-border-color: #EEEEEE; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
        <ListView fx:id="lvChatMessages" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;" />
    </VBox>

</VBox>