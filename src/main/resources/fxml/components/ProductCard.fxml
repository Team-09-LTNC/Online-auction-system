<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="350.0" prefWidth="250.0" spacing="10.0"
      styleClass="product-card"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.client.controller.components.ProductCardController">

    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>

    <StackPane prefHeight="150.0" prefWidth="220.0" style="-fx-background-color: #F8F9FA; -fx-background-radius: 8;">
        <Label fx:id="lblProductIcon" text="🚗" style="-fx-font-size: 60.0;" />

        <Label fx:id="lblStatus" styleClass="status-label" text="Đang diễn ra" StackPane.alignment="TOP_LEFT">
            <StackPane.margin>
                <Insets left="5.0" top="5.0" />
            </StackPane.margin>
        </Label>
    </StackPane>

    <Label fx:id="lblProductName" styleClass="product-title" text="Tên sản phẩm" wrapText="true">
        <VBox.margin>
            <Insets top="5.0" />
        </VBox.margin>
    </Label>

    <VBox spacing="2.0">
        <Label text="Giá hiện tại" style="-fx-text-fill: #888888; -fx-font-size: 12px;" />
        <Label fx:id="lblCurrentPrice" styleClass="product-price" text="0 đ" />
    </VBox>

    <Region VBox.vgrow="ALWAYS" />

    <HBox alignment="CENTER_LEFT">
        <VBox>
            <Label text="Kết thúc sau:" style="-fx-text-fill: #888888; -fx-font-size: 11px;" />
            <Label fx:id="lblTimeRemaining" text="00:00:00" style="-fx-text-fill: #E65100; -fx-font-weight: bold; -fx-font-size: 13px;" />
        </VBox>

        <Region HBox.hgrow="ALWAYS" />

        <Button fx:id="btnBid" onAction="#handleBidAction" styleClass="bid-button" text="Ra giá" />
    </HBox>

</VBox>