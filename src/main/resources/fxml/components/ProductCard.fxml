<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="385.0" prefWidth="250.0" spacing="10.0" styleClass="product-card" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.components.ProductCardController">

    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>

    <StackPane prefHeight="150.0" prefWidth="220.0" style="-fx-background-color: #F8F9FA; -fx-background-radius: 8; -fx-border-color: #E0E0E0; -fx-border-radius: 8;">

        <ImageView fx:id="imgProduct" fitHeight="148.0" fitWidth="218.0" pickOnBounds="true" preserveRatio="true" />

        <Label fx:id="lblStatus" styleClass="status-label" text="" StackPane.alignment="TOP_LEFT">
            <StackPane.margin>
                <Insets left="8.0" top="8.0" />
            </StackPane.margin>
        </Label>

        <Button fx:id="btnFollow" focusTraversable="false" maxHeight="32.0" maxWidth="32.0" minHeight="32.0" minWidth="32.0" mnemonicParsing="false" onAction="#handleFollowAction" prefHeight="32.0" prefWidth="32.0" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-text-fill: #888888; -fx-padding: 0;" text="♡" StackPane.alignment="TOP_RIGHT">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
            <StackPane.margin>
                <Insets right="8.0" top="2.0" />
            </StackPane.margin>
        </Button>
    </StackPane>

    <Label fx:id="lblProductName" styleClass="product-title" text="Đang tải..." wrapText="true">
        <VBox.margin>
            <Insets top="5.0" />
        </VBox.margin>
    </Label>

    <VBox spacing="2.0">
        <Label style="-fx-text-fill: #888888; -fx-font-size: 12px;" text="Giá hiện tại" />
        <Label fx:id="lblCurrentPrice" styleClass="product-price" text="0 đ" />
    </VBox>

    <HBox fx:id="sellerActions" alignment="CENTER_LEFT" managed="false" spacing="8.0" visible="false">
        <Button fx:id="btnEdit" mnemonicParsing="false" onAction="#handleEditAction" prefWidth="88.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #7A1B28; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #7A1B28; -fx-cursor: hand;" text="Sửa" />
        <Button fx:id="btnDelete" mnemonicParsing="false" onAction="#handleDeleteAction" prefWidth="88.0" style="-fx-background-color: #7A1B28; -fx-background-radius: 6; -fx-text-fill: #FFFFFF; -fx-cursor: hand;" text="Xóa" />
    </HBox>

    <Region VBox.vgrow="ALWAYS" />

    <HBox alignment="CENTER_LEFT">
        <VBox>
            <Label style="-fx-text-fill: #888888; -fx-font-size: 12px;" text="Thời gian còn lại" />
            <Label fx:id="lblTimeRemaining" style="-fx-font-weight: bold; -fx-text-fill: #D32F2F;" text="--:--:--" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnBid" minHeight="34.0" minWidth="112.0" mnemonicParsing="false" onAction="#handleBidAction" styleClass="auction-action-button" text="Vào phòng" />
    </HBox>
</VBox>
