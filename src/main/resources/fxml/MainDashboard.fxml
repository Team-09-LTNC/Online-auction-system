<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<VBox fx:controller="com.auction.client.controller.MainDashboardController"
      prefWidth="1000.0"
      prefHeight="800.0"
      style="-fx-background-color: #FDFBF9;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1">

    <!-- PHẦN 1: HEADER (Tìm kiếm + User) - Đã thu hẹp chiều cao -->
    <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="20.0" style="-fx-padding: 10 30 10 30;">
        <TextField prefHeight="40.0" prefWidth="450.0" promptText="Tìm kiếm sản phẩm, người bán..."
                   style="-fx-background-color: #FFFFFF; -fx-background-radius: 25; -fx-border-color: #EEEEEE; -fx-border-radius: 25; -fx-padding: 0 15;" />
        <Region HBox.hgrow="ALWAYS" />
        <HBox alignment="CENTER" spacing="15.0">
            <Label text="🔔" style="-fx-font-family: 'Segoe UI Emoji'; -fx-font-size: 18;" />
            <VBox alignment="CENTER_RIGHT">
                <Label text="Chào, Nguyễn An" textFill="#3E2723">
                    <font><Font name="System Bold" size="14.0" /></font>
                </Label>
                <Label text="Bidder" textFill="#888888" style="-fx-font-size: 11;" />
            </VBox>
            <Circle fill="#7A1B28" radius="18.0" />
        </HBox>
    </HBox>

    <!-- PHẦN 2: NỘI DUNG CUỘN -->
    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
        <content>
            <!-- Giảm spacing giữa các dòng từ 30 xuống 20 để khít hơn -->
            <VBox spacing="20.0" style="-fx-padding: 10 30 30 30;">

                <HBox alignment="CENTER_LEFT" spacing="20.0"
                      style="-fx-background-color: #FFFFFF; -fx-background-radius: 20; -fx-padding: 15 25; -fx-border-color: #F0F0F0; -fx-border-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 10, 0, 0, 5);">

                    <!-- Nhóm bên trái: Lời chào -->
                    <VBox alignment="CENTER_LEFT" spacing="2.0">
                        <Label text="Chào mừng trở lại, Nguyễn An! 👋" textFill="#3E2723">
                            <font><Font name="System Bold" size="18.0" /></font>
                        </Label>
                        <Label text="Khám phá các phiên đấu giá hấp dẫn ngay hôm nay." textFill="#888888">
                            <font><Font size="12.0" /></font>
                        </Label>
                    </VBox>

                    <!-- Lò xo đẩy phần thống kê sang phải -->
                    <Region HBox.hgrow="ALWAYS" />

                    <!-- Nhóm bên phải: 4 ô thống kê thu nhỏ nằm ngang -->
                    <HBox alignment="CENTER" spacing="25.0">
                        <!-- Ô 1: Phiên đang diễn ra -->
                        <HBox alignment="CENTER" spacing="10.0">
                            <Label text="🔨" textFill="#7A1B28" style="-fx-font-size: 16;" />
                            <VBox alignment="CENTER_LEFT">
                                <Label text="128" textFill="#3E2723"><font><Font name="System Bold" size="16.0" /></font></Label>
                                <Label text="Đang diễn ra" textFill="#888888" style="-fx-font-size: 10;" />
                            </VBox>
                        </HBox>

                        <Region prefWidth="1.0" style="-fx-background-color: #EEEEEE; -fx-min-height: 30;" /> <!-- Vạch ngăn cách -->

                        <!-- Ô 2: Sắp kết thúc -->
                        <HBox alignment="CENTER" spacing="10.0">
                            <Label text="⏳" textFill="#7A1B28" style="-fx-font-size: 16;" />
                            <VBox alignment="CENTER_LEFT">
                                <Label text="23" textFill="#3E2723"><font><Font name="System Bold" size="16.0" /></font></Label>
                                <Label text="Sắp kết thúc" textFill="#888888" style="-fx-font-size: 10;" />
                            </VBox>
                        </HBox>

                        <Region prefWidth="1.0" style="-fx-background-color: #EEEEEE; -fx-min-height: 30;" />

                        <!-- Ô 3: Đang theo dõi -->
                        <HBox alignment="CENTER" spacing="10.0">
                            <Label text="♡" textFill="#7A1B28" style="-fx-font-size: 16;" />
                            <VBox alignment="CENTER_LEFT">
                                <Label text="56" textFill="#3E2723"><font><Font name="System Bold" size="16.0" /></font></Label>
                                <Label text="Theo dõi" textFill="#888888" style="-fx-font-size: 10;" />
                            </VBox>
                        </HBox>

                        <Region prefWidth="1.0" style="-fx-background-color: #EEEEEE; -fx-min-height: 30;" />

                        <!-- Ô 4: Đấu giá của tôi -->
                        <HBox alignment="CENTER" spacing="10.0">
                            <Label text="🏷️" textFill="#7A1B28" style="-fx-font-family: 'Segoe UI Emoji'; -fx-font-size: 16;" />
                            <VBox alignment="CENTER_LEFT">
                                <Label text="12" textFill="#3E2723"><font><Font name="System Bold" size="16.0" /></font></Label>
                                <Label text="Đấu giá của tôi" textFill="#888888" style="-fx-font-size: 10;" />
                            </VBox>
                        </HBox>
                    </HBox>
                </HBox>

                <!-- DÒNG 3: Khu vực chính - Nội dung sẽ trồi lên cao hơn -->
                <HBox spacing="20.0">
                    <!-- Ô Phiên đấu giá nổi bật -->
                    <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #FFFFFF; -fx-background-radius: 20; -fx-padding: 20; -fx-border-color: #F0F0F0; -fx-border-radius: 20;">
                        <HBox alignment="CENTER_LEFT" style="-fx-padding: 0 0 20 0;">
                            <Label text="🔥 Phiên đấu giá nổi bật" textFill="#3E2723">
                                <font><Font name="System Bold" size="18.0" /></font>
                            </Label>
                            <Region HBox.hgrow="ALWAYS" />
                            <Label text="Xem tất cả →" textFill="#7A1B28" style="-fx-cursor: hand;" />
                        </HBox>

                        <!-- Đây là phần lấy từ MainContent cũ sang m nhé -->
                        <FlowPane hgap="15.0" vgap="15.0">
                            <fx:include source="/fxml/ProductCard.fxml" />
                            <fx:include source="/fxml/ProductCard.fxml" />
                            <fx:include source="/fxml/ProductCard.fxml" />
                            <fx:include source="/fxml/ProductCard.fxml" />
                        </FlowPane>
                    </VBox>

                    <!-- Ô Hoạt động gần đây -->
                    <VBox prefWidth="320.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 20; -fx-padding: 20; -fx-border-color: #F0F0F0; -fx-border-radius: 20;">
                        <Label text="📈 Hoạt động gần đây" textFill="#3E2723">
                            <font><Font name="System Bold" size="16.0" /></font>
                            <VBox.margin><Insets bottom="20.0" /></VBox.margin>
                        </Label>
                        <VBox spacing="15.0">
                            <HBox spacing="12.0">
                                <Circle fill="#7A1B28" radius="16.0" />
                                <VBox spacing="2.0">
                                    <Label text="MinhTrung89 đã đặt giá" textFill="#3E2723" wrapText="true">
                                        <font><Font name="System Bold" size="12.0" /></font>
                                    </Label>
                                    <Label text="28.500.000 đ cho iPhone..." textFill="#555555" wrapText="true" />
                                    <Label text="1 phút trước" textFill="#AAAAAA" style="-fx-font-size: 10;" />
                                </VBox>
                            </HBox>
                            <HBox spacing="12.0">
                                <Circle fill="#DDDDDD" radius="16.0" />
                                <VBox spacing="2.0">
                                    <Label text="ArtLover đã đặt giá" textFill="#3E2723" wrapText="true">
                                        <font><Font name="System Bold" size="12.0" /></font>
                                    </Label>
                                    <Label text="15.200.000 đ cho Tranh sơn dầu..." textFill="#555555" wrapText="true" />
                                    <Label text="5 phút trước" textFill="#AAAAAA" style="-fx-font-size: 10;" />
                                </VBox>
                            </HBox>
                        </VBox>
                        <Region VBox.vgrow="ALWAYS" />
                        <Label text="Xem tất cả hoạt động →" textFill="#7A1B28" alignment="CENTER" maxWidth="Infinity" style="-fx-cursor: hand;">
                            <font><Font size="12.0" /></font>
                            <VBox.margin><Insets top="20.0" /></VBox.margin>
                        </Label>
                    </VBox>
                </HBox>

            </VBox>
        </content>
    </ScrollPane>
</VBox>