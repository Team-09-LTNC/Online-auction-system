<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane prefHeight="650.0" prefWidth="1000.0"
            style="-fx-background-color: #EDE6DF;"
            xmlns="http://javafx.com/javafx/17.0.2"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.client.controller.SellerDashboardController">

    <!-- ===== HEADER ===== -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0"
              style="-fx-background-color: #6E1C1C; -fx-padding: 15 20 15 20;">
            <Label text="AuctionHub"
                   style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Separator orientation="VERTICAL"
                       style="-fx-background-color: rgba(255,255,255,0.4);"/>
            <Label text="Quản lý sản phẩm"
                   style="-fx-text-fill: rgba(255,255,255,0.85); -fx-font-size: 13px;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblWelcome" text="Xin chào!"
                   style="-fx-text-fill: white; -fx-font-size: 13px;"/>
            <!-- ===== NÚT QUAY VỀ HOME  ===== -->
            <Button fx:id="btnLogout" text="← Quay về"
                    onAction="#onBackToHomeClick"
                    style="-fx-background-color: transparent;
                       -fx-text-fill: white;
                       -fx-font-size: 13px;
                       -fx-font-weight: bold;
                       -fx-cursor: hand;
                       -fx-padding: 5 10 5 10;
                       -fx-underline: true;">
                <tooltip>
                    <Tooltip text="Quay về trang chủ"/>
                </tooltip>
            </Button>
        </HBox>
    </top>

    <!-- ===== MENU BÊN TRÁI ===== -->
    <left>
        <VBox prefWidth="190.0" spacing="0.0"
              style="-fx-background-color: #F0EAE4; -fx-border-color: #C8AFA0; -fx-border-width: 0 1 0 0;">
            <padding><Insets top="20.0"/></padding>

            <Label text="MENU"
                   style="-fx-text-fill: #5C3D30; -fx-font-size: 11px;
                          -fx-font-weight: bold; -fx-padding: 0 0 8 15;"/>

            <Button fx:id="btnMenuMyItems" text="📦  Sản phẩm của tôi"
                    onAction="#onMenuMyItemsClick"
                    maxWidth="1.7976931348623157E308"
                    style="-fx-background-color: #6E1C1C; -fx-text-fill: white;
                           -fx-font-size: 13px; -fx-padding: 12 15 12 15;
                           -fx-background-radius: 0; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;"/>

            <Button fx:id="btnMenuAddNew" text="➕  Đăng sản phẩm mới"
                    onAction="#onMenuAddNewClick"
                    maxWidth="1.7976931348623157E308"
                    style="-fx-background-color: transparent; -fx-text-fill: #1A0F0A;
                           -fx-font-size: 13px; -fx-padding: 12 15 12 15;
                           -fx-background-radius: 0; -fx-cursor: hand; -fx-alignment: CENTER_LEFT;"/>
        </VBox>
    </left>

    <!-- ===== NỘI DUNG CHÍNH ===== -->
    <center>
        <StackPane>

            <!-- PANE 1: Danh sách sản phẩm -->
            <VBox fx:id="paneMyItems" spacing="12.0" style="-fx-padding: 25;">

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="Sản phẩm của tôi"
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1A0F0A;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="🔄 Tải lại" onAction="#onRefreshClick"
                            style="-fx-background-color: #C8AFA0; -fx-font-weight: bold;
                                   -fx-background-radius: 6; -fx-cursor: hand;"/>
                </HBox>

                <Separator/>

                <TableView fx:id="itemTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colName"     text="Tên sản phẩm"  prefWidth="220.0"/>
                        <TableColumn fx:id="colCategory" text="Loại"           prefWidth="100.0"/>
                        <TableColumn fx:id="colPrice"    text="Giá khởi điểm" prefWidth="130.0"/>
                        <TableColumn fx:id="colStatus"   text="Trạng thái"     prefWidth="100.0"/>
                        <TableColumn fx:id="colAction"   text="Hành động"      prefWidth="150.0"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <placeholder>
                        <Label text="Bạn chưa có sản phẩm nào"
                               style="-fx-text-fill: #5C3D30; -fx-font-style: italic;"/>
                    </placeholder>
                </TableView>

                <Label text="Chỉ có thể sửa/xóa sản phẩm khi trạng thái là OPEN."
                       style="-fx-text-fill: #5C3D30; -fx-font-style: italic; -fx-font-size: 11px;"/>

            </VBox>

            <!-- PANE 2: Form đăng sản phẩm mới -->
            <ScrollPane fx:id="paneAddNew" fitToWidth="true"
                        visible="false" managed="false"
                        style="-fx-background-color: transparent; -fx-background: transparent;">

                <VBox spacing="14.0" style="-fx-padding: 30 40 30 40;" maxWidth="580.0">

                    <Label text="Đăng sản phẩm mới"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1A0F0A;"/>
                    <Separator/>

                    <!-- Loại sản phẩm -->
                    <VBox spacing="5.0">
                        <Label text="Loại sản phẩm *"
                               style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #1A0F0A;"/>
                        <ComboBox fx:id="cbCategory"
                                  promptText="-- Chọn loại sản phẩm --"
                                  onAction="#onCategoryChanged"
                                  maxWidth="1.7976931348623157E308"
                                  style="-fx-background-color: white; -fx-border-color: #C8AFA0;
                                         -fx-border-radius: 6; -fx-background-radius: 6;"/>
                    </VBox>

                    <!-- Tên sản phẩm -->
                    <VBox spacing="5.0">
                        <Label text="Tên sản phẩm *"
                               style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #1A0F0A;"/>
                        <TextField fx:id="tfName" promptText="Nhập tên sản phẩm"
                                   style="-fx-background-color: white; -fx-border-color: #C8AFA0;
                                          -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8;
                                          -fx-text-fill: #1A0F0A; -fx-prompt-text-fill: #999;"/>
                    </VBox>

                    <!-- Mô tả -->
                    <VBox spacing="5.0">
                        <Label text="Mô tả"
                               style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #1A0F0A;"/>
                        <TextArea fx:id="taDescription" promptText="Nhập mô tả sản phẩm"
                                  prefRowCount="3" wrapText="true"
                                  style="-fx-background-color: white; -fx-border-color: #C8AFA0;
                                         -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8;
                                         -fx-text-fill: #1A0F0A; -fx-prompt-text-fill: #999;"/>
                    </VBox>

                    <!-- Giá khởi điểm -->
                    <VBox spacing="5.0">
                        <Label text="Giá khởi điểm (VNĐ) *"
                               style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #1A0F0A;"/>
                        <TextField fx:id="tfPrice" promptText="VD: 500000"
                                   style="-fx-background-color: white; -fx-border-color: #C8AFA0;
                                          -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8;
                                          -fx-text-fill: #1A0F0A; -fx-prompt-text-fill: #999;"/>
                    </VBox>

                    <!-- Thời gian đấu giá -->
                    <VBox spacing="5.0">
                        <Label text="Thời gian đấu giá (phút) *"
                               style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #1A0F0A;"/>
                        <TextField fx:id="tfDuration" promptText="VD: 60"
                                   style="-fx-background-color: white; -fx-border-color: #C8AFA0;
                                          -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8;
                                          -fx-text-fill: #1A0F0A; -fx-prompt-text-fill: #999;"/>
                    </VBox>

                    <!-- ===== Sub-pane ART ===== -->
                    <VBox fx:id="paneArtFields" spacing="10.0"
                          visible="false" managed="false"
                          style="-fx-background-color: #F8F3EF; -fx-padding: 14;
                                 -fx-border-color: #C8AFA0; -fx-border-radius: 8;
                                 -fx-background-radius: 8;">
                        <Label text="🎨  Thông tin tác phẩm nghệ thuật"
                               style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #6E1C1C;"/>
                        <VBox spacing="5.0">
                            <Label text="Tác giả"
                                   style="-fx-font-size: 12px; -fx-text-fill: #1A0F0A; -fx-font-weight: bold;"/>
                            <TextField fx:id="tfArtist" promptText="Tên tác giả"
                                       style="-fx-background-color: white; -fx-border-color: #C8AFA0;
                                              -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 7;
                                              -fx-text-fill: #1A0F0A;"/>
                        </VBox>
                        <VBox spacing="5.0">
                            <Label text="Năm sáng tác"
                                   style="-fx-font-size: 12px; -fx-text-fill: #1A0F0A; -fx-font-weight: bold;"/>
                            <TextField fx:id="tfYear" promptText="VD: 2024"
                                       style="-fx-background-color: white; -fx-border-color: #C8AFA0;
                                              -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 7;
                                              -fx-text-fill: #1A0F0A;"/>
                        </VBox>
                        <VBox spacing="5.0">
                            <Label text="Chất liệu"
                                   style="-fx-font-size: 12px; -fx-text-fill: #1A0F0A; -fx-font-weight: bold;"/>
                            <TextField fx:id="tfMedium" promptText="VD: Sơn dầu"
                                       style="-fx-background-color: white; -fx-border-color: #C8AFA0;
                                              -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 7;
                                              -fx-text-fill: #1A0F0A;"/>
                        </VBox>
                    </VBox>

                    <!-- ===== Sub-pane ELECTRONICS ===== -->
                    <VBox fx:id="paneElecFields" spacing="10.0"
                          visible="false" managed="false"
                          style="-fx-background-color: #F8F3EF; -fx-padding: 14;
                                 -fx-border-color: #C8AFA0; -fx-border-radius: 8;
                                 -fx-background-radius: 8;">
                        <Label text="💻  Thông tin thiết bị điện tử"
                               style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #6E1C1C;"/>
                        <VBox spacing="5.0">
                            <Label text="Hãng sản xuất"
                                   style="-fx-font-size: 12px; -fx-text-fill: #1A0F0A; -fx-font-weight: bold;"/>
                            <TextField fx:id="tfBrand" promptText="VD: Samsung, Apple"
                                       style="-fx-background-color: white; -fx-border-color: #C8AFA0;
                                              -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 7;
                                              -fx-text-fill: #1A0F0A;"/>
                        </VBox>
                        <VBox spacing="5.0">
                            <Label text="Bảo hành (tháng)"
                                   style="-fx-font-size: 12px; -fx-text-fill: #1A0F0A; -fx-font-weight: bold;"/>
                            <TextField fx:id="tfWarranty" promptText="VD: 12"
                                       style="-fx-background-color: white; -fx-border-color: #C8AFA0;
                                              -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 7;
                                              -fx-text-fill: #1A0F0A;"/>
                        </VBox>
                    </VBox>

                    <!-- ===== Sub-pane VEHICLE ===== -->
                    <VBox fx:id="paneVehicleFields" spacing="10.0"
                          visible="false" managed="false"
                          style="-fx-background-color: #F8F3EF; -fx-padding: 14;
                                 -fx-border-color: #C8AFA0; -fx-border-radius: 8;
                                 -fx-background-radius: 8;">
                        <Label text="🚗  Thông tin phương tiện"
                               style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #6E1C1C;"/>
                        <VBox spacing="5.0">
                            <Label text="Hãng xe"
                                   style="-fx-font-size: 12px; -fx-text-fill: #1A0F0A; -fx-font-weight: bold;"/>
                            <TextField fx:id="tfMake" promptText="VD: Toyota, Honda"
                                       style="-fx-background-color: white; -fx-border-color: #C8AFA0;
                                              -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 7;
                                              -fx-text-fill: #1A0F0A;"/>
                        </VBox>
                        <VBox spacing="5.0">
                            <Label text="Dòng xe"
                                   style="-fx-font-size: 12px; -fx-text-fill: #1A0F0A; -fx-font-weight: bold;"/>
                            <TextField fx:id="tfModel" promptText="VD: Camry, Civic"
                                       style="-fx-background-color: white; -fx-border-color: #C8AFA0;
                                              -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 7;
                                              -fx-text-fill: #1A0F0A;"/>
                        </VBox>
                        <VBox spacing="5.0">
                            <Label text="Năm sản xuất"
                                   style="-fx-font-size: 12px; -fx-text-fill: #1A0F0A; -fx-font-weight: bold;"/>
                            <TextField fx:id="tfVehicleYear" promptText="VD: 2020"
                                       style="-fx-background-color: white; -fx-border-color: #C8AFA0;
                                              -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 7;
                                              -fx-text-fill: #1A0F0A;"/>
                        </VBox>
                    </VBox>


                    <!-- Nút hành động -->
                    <HBox spacing="12.0">
                        <Button fx:id="btnDang" text="Đăng sản phẩm"
                                onAction="#onDangClick"
                                style="-fx-background-color: #6E1C1C; -fx-text-fill: white;
                                       -fx-font-weight: bold; -fx-background-radius: 8;
                                       -fx-padding: 10 24 10 24; -fx-cursor: hand;"/>
                        <Button text="Xóa form" onAction="#onClearFormClick"
                                style="-fx-background-color: #C8AFA0; -fx-text-fill: #1A0F0A;
                                       -fx-font-weight: bold; -fx-background-radius: 8;
                                       -fx-padding: 10 24 10 24; -fx-cursor: hand;"/>
                    </HBox>

                </VBox>
            </ScrollPane>

        </StackPane>
    </center>

    <!-- ===== BOTTOM: Thanh trạng thái chung ===== -->
    <bottom>
        <HBox style="-fx-background-color: #F0EAE4; -fx-padding: 8 20 8 20; -fx-border-color: #C8AFA0; -fx-border-width: 1 0 0 0;">
            <Label fx:id="lblStatus" text="" wrapText="true"
                   maxWidth="1.7976931348623157E308"
                   style="-fx-font-size: 12px; -fx-text-fill: #5C3D30;"/>
        </HBox>
    </bottom>

</BorderPane>