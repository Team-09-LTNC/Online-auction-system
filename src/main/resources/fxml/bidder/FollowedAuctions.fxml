<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.layout.FlowPane?>

<VBox fx:controller="com.auction.client.controller.bidder.FollowedAuctionsController"
      prefWidth="1000.0"
      prefHeight="800.0"
      style="-fx-background-color: #FDFBF9;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1">

    <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="20.0" style="-fx-padding: 10 30 10 30;">
        <TextField prefHeight="40.0" prefWidth="450.0" promptText="Tìm trong danh sách theo dõi..." style="-fx-background-color: #FFFFFF; -fx-background-radius: 25; -fx-border-color: #EEEEEE; -fx-border-radius: 25; -fx-padding: 0 15;" />
        <Region HBox.hgrow="ALWAYS" />
        <HBox alignment="CENTER" spacing="15.0">
            <Label style="-fx-font-family: 'Segoe UI Emoji'; -fx-font-size: 18;" text="🔔" />
            <VBox alignment="CENTER_RIGHT">
                <Label fx:id="lblHeaderName" text="Chào, Đang tải..." textFill="#3E2723">
                    <font><Font name="System Bold" size="14.0" /></font>
                </Label>
                <Label fx:id="lblHeaderRole" style="-fx-font-size: 11;" text="Vai trò" textFill="#888888" />
            </VBox>
            <Circle fill="#7A1B28" radius="18.0" />
        </HBox>
    </HBox>

    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
        <content>
            <VBox spacing="20.0" style="-fx-padding: 10 30 30 30;">

                <HBox alignment="CENTER_LEFT" style="-fx-background-color: #FFFFFF; -fx-background-radius: 20; -fx-padding: 15 25; -fx-border-color: #F0F0F0; -fx-border-radius: 20;">
                    <VBox alignment="CENTER_LEFT" spacing="2.0">
                        <Label text="Danh sách yêu thích ♡" textFill="#3E2723">
                            <font><Font name="System Bold" size="18.0" /></font>
                        </Label>
                        <Label text="Đừng bỏ lỡ các phiên đấu giá bạn đã quan tâm nhé!" textFill="#888888">
                            <font><Font size="12.0" /></font>
                        </Label>
                    </VBox>
                </HBox>

                <HBox spacing="20.0">
                    <VBox style="-fx-background-color: #FFFFFF; -fx-background-radius: 20; -fx-padding: 20; -fx-border-color: #F0F0F0; -fx-border-radius: 20;" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" style="-fx-padding: 0 0 20 0;">
                            <Label text="🔔 Phiên đang theo dõi" textFill="#3E2723">
                                <font><Font name="System Bold" size="18.0" /></font>
                            </Label>
                            <Region HBox.hgrow="ALWAYS" />
                            <Label style="-fx-cursor: hand;" text="Lọc theo thời gian ↓" textFill="#7A1B28" />
                        </HBox>

                        <FlowPane fx:id="productFlowPane" hgap="15.0" vgap="15.0">
                        </FlowPane>
                    </VBox>
                </HBox>

            </VBox>
        </content>
    </ScrollPane>
</VBox>