<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="800.0" prefWidth="1000.0"
    style="-fx-background-color: #FDFBF9;"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.auction.client.controller.bidder.AuctionListScreenController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="65.0"
            style="-fx-background-color: #FFF5E1; -fx-padding: 0 25 0 15;"
            BorderPane.alignment="CENTER">

            <Region HBox.hgrow="ALWAYS" />
            <Label text="PHIÊN ĐẤU GIÁ" textFill="#3E2723">
                <font>
                    <Font name="System Bold" size="22.0" />
                </font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />

            <Region prefWidth="105.0" />

        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
            style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;"
            BorderPane.alignment="CENTER">
            <content>
                <VBox spacing="20.0" style="-fx-padding: 20 30 30 30;">
                    <VBox
                        style="-fx-background-color: #FFFFFF; -fx-background-radius: 20; -fx-padding: 20; -fx-border-color: #F0F0F0; -fx-border-radius: 20;"
                        VBox.vgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-padding: 0 0 20 0;">
                            <Label text="📋 Danh sách phiên đấu giá" textFill="#3E2723">
                                <font>
                                    <Font name="System Bold" size="18.0" />
                                </font>
                            </Label>

                            <Region HBox.hgrow="ALWAYS" />
                            <!-- Thanh tìm kiếm và Lọc trạng thái -->
                            <TextField fx:id="txtSearch" prefHeight="35.0" prefWidth="250.0"
                                promptText="🔍 Tìm kiếm sản phẩm..." styleClass="search-field" />
                            <ComboBox fx:id="cbStatus" prefHeight="35.0" prefWidth="150.0"
                                promptText="Trạng thái"
                                style="-fx-background-color: #FFFFFF; -fx-border-color: #F0EAE8; -fx-border-radius: 25; -fx-background-radius: 25; -fx-padding: 0 5 0 5; -fx-cursor: hand;" />
                        </HBox>

                        <FlowPane fx:id="productFlowPane" hgap="15.0" vgap="15.0">
                        </FlowPane>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
