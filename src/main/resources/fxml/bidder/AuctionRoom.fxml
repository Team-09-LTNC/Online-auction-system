<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<HBox prefHeight="700.0" prefWidth="1000.0" spacing="20.0" style="-fx-background-color: #FDFBF9;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.client.controller.bidder.AuctionRoomController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <VBox spacing="15.0" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">

        <Label fx:id="lblProductName" text="Mercedes-Benz S450 2023" textFill="#3E2723">
            <font><Font name="System Bold" size="24.0" /></font>
        </Label>

        <StackPane prefHeight="350.0" style="-fx-background-color: #F8F9FA; -fx-background-radius: 10; -fx-border-color: #EEEEEE; -fx-border-radius: 10;">
            <children>
                <Label text="🚗" style="-fx-font-size: 100; -fx-opacity: 0.2;" />

                <ImageView fx:id="imgProduct" fitHeight="340.0" fitWidth="580.0"
                           pickOnBounds="true" preserveRatio="true" style="-fx-background-radius: 8;" />
            </children>
        </StackPane>

        <VBox spacing="10.0" VBox.vgrow="ALWAYS">
            <Label text="Chi tiết sản phẩm" style="-fx-font-weight: bold; -fx-font-size: 16;" />
            <TextArea fx:id="txtDescription" editable="false" wrapText="true"
                      text="Xe chính chủ, bảo dưỡng định kỳ. Nội thất sang trọng, hỗ trợ lái tự động..."
                      style="-fx-background-color: transparent; -fx-border-color: #EEEEEE;" VBox.vgrow="ALWAYS" />
        </VBox>
    </VBox>

    <VBox spacing="15.0" prefWidth="350.0">

        <VBox alignment="CENTER" style="-fx-background-color: #7A1B28; -fx-background-radius: 15; -fx-padding: 15;">
            <Label text="THỜI GIAN CÒN LẠI" textFill="WHITE" style="-fx-font-size: 11; -fx-font-weight: bold;" />
            <Label fx:id="lblCountdown" text="00:10:45" textFill="WHITE">
                <font><Font name="System Bold" size="32.0" /></font>
            </Label>
        </VBox>

        <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15; -fx-border-color: #EEEEEE;">
            <Label text="Giá cao nhất hiện tại:" textFill="#888888" />
            <Label fx:id="lblCurrentPrice" text="3.500.000.000 đ" textFill="#7A1B28">
                <font><Font name="System Bold" size="24.0" /></font>
            </Label>
            <Label fx:id="lblLeader" text="Người dẫn đầu: Nguyễn An" style="-fx-font-size: 12;" />
        </VBox>

        <VBox VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 10; -fx-border-color: #EEEEEE;">
            <Label text="Lịch sử trả giá" style="-fx-font-weight: bold; -fx-padding: 0 0 5 5;" />
            <ListView fx:id="lvBidHistory" VBox.vgrow="ALWAYS" />
        </VBox>

        <VBox spacing="10.0" style="-fx-background-color: #FDF8F8; -fx-background-radius: 15; -fx-padding: 15; -fx-border-color: #E8DFD8;">
            <Label text="🤖 CHẾ ĐỘ AUTO BIDDING" textFill="#7A1B28" style="-fx-font-weight: bold; -fx-font-size: 12;" />
            <HBox spacing="10.0">
                <children>
                    <TextField fx:id="txtMaxAutoBid" prefHeight="40.0" promptText="Giá trần tối đa..." HBox.hgrow="ALWAYS"
                               style="-fx-background-radius: 8; -fx-alignment: center; -fx-font-size: 13;" />
                    <Button fx:id="btnEnableAutoBid" onAction="#handleEnableAutoBid" prefHeight="40.0" prefWidth="120.0"
                            text="KÍCH HOẠT"
                            style="-fx-background-color: #5D4037; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" />
                </children>
            </HBox>
        </VBox>

        <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15; -fx-border-color: #EEEEEE;">
            <Label text="Đặt giá thủ công:" textFill="#888888" style="-fx-font-size: 12; -fx-font-weight: bold;" />
            <TextField fx:id="txtBidAmount" prefHeight="45.0" promptText="Nhập số tiền..."
                       style="-fx-background-radius: 10; -fx-alignment: center; -fx-font-size: 15;" />
            <Button fx:id="btnPlaceBid" onAction="#handlePlaceBid" prefHeight="45.0" prefWidth="Infinity"
                    text="RA GIÁ NGAY"
                    style="-fx-background-color: #7A1B28; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;" />
        </VBox>
    </VBox>
</HBox>